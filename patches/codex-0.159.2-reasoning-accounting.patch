-            sess.set_server_reasoning_included(/*included*/ false).await;
+            // Responses Lite explicitly requests reasoning.context=all_turns. Its
+            // usage already includes previous reasoning even when the response
+            // omits x-reasoning-included, including after a session is resumed.
+            // Otherwise retain the previous response's contract until pre-turn
+            // compaction has inspected the usage that belongs to that response.
+            if ctx.capture_current_model_info().use_responses_lite {
+                sess.set_server_reasoning_included(/*included*/ true).await;
+            }
             sess.consume_startup_prewarm_for_regular_turn(&cancellation_token)
                 .await
         }
